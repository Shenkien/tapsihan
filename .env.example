# GCash: customers pay the store's static QR (set it in Admin > GCash Payment)
# and staff confirm the payment on the Staff screen. No payment provider is used.
# GCASH_MERCHANT_QR_PATH=   # optional fallback only; normally upload the QR in Admin > GCash Payment

# Print bridge: shared secret for the bridge devices' "print result" reports.
# Set this on the server, then open each bridge page ONCE with ?key=THIS_VALUE
# (e.g. /print-bridge?key=...). Generate one:  openssl rand -base64 24
# In production, if this is empty every print report is rejected.
PRINT_BRIDGE_KEY="fea6b7d4329abb1785717b8dc4e532353c64625c23854a43"

# Local testing ONLY — never set these on the live site. They enable the
# "Simulate paid" button and /api/dev/print-log.
# ALLOW_PAYMENT_SIMULATION=true
# NEXT_PUBLIC_ALLOW_PAYMENT_SIMULATION=true

# First-run seed only: passwords for the starting "admin" and "staff" accounts.
# These are throwaway DEV values. Both accounts must choose a new password at
# first login. Never seed a live database with them; for production, change
# these first or delete both lines so the seed generates random ones.
SEED_ADMIN_PASSWORD=admin
SEED_STAFF_PASSWORD=staff
